{
    "name": "ipsum3/core",
    "description": "Core package for Ipsum applications built with Laravel.",
    "license": "MIT",
    "authors": [
        {
            "name": "B1nj",
            "email": "postmaster@b1nj.fr"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "prologue/alerts": "^1.0",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/console": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/session": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0"
    },
    "require-dev": {
        "fruitcake/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Ipsum\\Core\\": "src"
        },
        "files": [
            "src/app/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ipsum\\Core\\CoreServiceProvider"
            ]
        }
    }
}
